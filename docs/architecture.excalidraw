   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rules, in order: whose word counts (document >\nowner > plan/chat; hints never count), what\nsettles this question, is it out of date?\nEach question gets one status and a reason.",
   "originalText": "Rules, in order: whose word counts (document >\nowner > plan/chat; hints never count), what\nsettles this question, is it out of date?\nEach question gets one status and a reason.",
