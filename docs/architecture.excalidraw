   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why a separate call? 'Are these the same\nneed?' needs every ask of the deal at once.\nCode rejects any id the model was not shown.",
   "originalText": "Why a separate call? 'Are these the same\nneed?' needs every ask of the deal at once.\nCode rejects any id the model was not shown.",
