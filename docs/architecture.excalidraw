   "versionNonce": 2100080515,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "An ask = one thing the customer asked\nfor, exactly as they said it, before any\nmerging. The same need can arrive 3 times.",
   "originalText": "An ask = one thing the customer asked\nfor, exactly as they said it, before any\nmerging. The same need can arrive 3 times.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e31",
   "type": "text",
   "x": 800,
   "y": 855,
   "width": 300,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1811180650,
   "version": 1,
   "versionNonce": 168393880,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Never overwritten: four statements can\ndisagree about one question and all four\nstay. That is how conflicts show up.",
   "originalText": "Never overwritten: four statements can\ndisagree about one question and all four\nstay. That is how conflicts show up.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
